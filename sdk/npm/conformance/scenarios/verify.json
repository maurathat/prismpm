      "expect": {
        "ok": true,
        "result": {
          "schema": "prism/verdict/1",
          "holo": "sha256:579982050f4ae916d5d97f6d87d22f6a6228dd92ed1535529ad7b84416ba7581",
          "level": "P0",
          "policy": {
            "name": "default",
            "minimum": "P2"
          },
          "passed": false,
          "reasons": {
            "$contains": [
              {
                "check": "provenance.statement",
                "withholds": "P1"
              },
              {
                "check": "proof.statement",
                "withholds": "P2"
              },
              {
                "check": "replay.statement",
                "withholds": "P3"
              },
              {
                "check": "policy.level",
                "code": "PP5601",
                "withholds": null
              }
            ],
            "$excludes": [
              {
                "check": "holo.integrity"
              },
              {
                "check": "holo.documents"
              }
            ]
          }
        }
      }
    },
