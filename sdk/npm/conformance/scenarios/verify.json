{
  "feature": "verify",
  "title": "Verify a holo",
  "checks": [
    {
      "id": "verify.reference.default-policy",
      "title": "The default policy fails the reference holo at P0, and names every missing statement.",
      "op": "verify",
      "archive": "reference",
      "expect": {
        "ok": true,
        "result": {
          "schema": "prism/verdict/1",
          "holo": "blake3:8408e0895572fab09e783f7aadb129dc4cb96d0b62850a16f3ddbe44ed6021ba",
          "level": "P0",
          "policy": {
            "name": "default",
            "minimum": "P2"
          },
          "passed": false,
          "reasons": {
            "$contains": [
              {
                "check": "provenance.statement",
                "withholds": "P1"
              },
              {
                "check": "proof.statement",
                "withholds": "P2"
              },
              {
                "check": "replay.statement",
                "withholds": "P3"
              },
              {
                "check": "policy.level",
                "code": "PP5601",
                "withholds": null
              }
            ]
          }
        }
      }
    },
    {
      "id": "verify.reference-v5.default-policy",
      "title": "A holo v5 gets the same verdict as the v4 reference, named by the κ of the file (ADR-017).",
      "op": "verify",
