 "tokenColors": [
  {
   "name": "comment",
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#a6a4a2",
    "fontStyle": "italic"
   }
  },
  {
   "name": "keyword",
   "scope": [
    "keyword",
    "storage",
    "storage.type",
    "storage.modifier",
    "keyword.control"
   ],
   "settings": {
    "foreground": "#f6f5f4",
    "fontStyle": "bold"
   }
  },
  {
   "name": "type",
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.type",
    "support.class",
    "entity.other.inherited-class"
   ],
   "settings": {
    "foreground": "#ceccca",
    "fontStyle": "italic"
   }
  },
  {
   "name": "string",
   "scope": [
    "string",
    "string.quoted",
    "string.template",
    "constant.other.symbol"
   ],
   "settings": {
    "foreground": "#5fd18b"
   }
  },
  {
   "name": "number",
   "scope": [
    "constant.numeric",
    "constant.language",
    "constant.character"
   ],
   "settings": {
    "foreground": "#d6d4d2"
   }
  },
  {
   "name": "operator",
   "scope": [
    "keyword.operator",
    "punctuation",
    "meta.brace"
   ],
   "settings": {
    "foreground": "#a6a4a2"
   }
  },
  {
   "name": "property",
   "scope": [
    "variable.other.property",
    "support.type.property-name",
    "entity.other.attribute-name",
    "meta.object-literal.key",
    "entity.name.tag"
   ],
   "settings": {
    "foreground": "#d6d4d2"
   }
  },
  {
   "name": "namespace",
   "scope": [
    "entity.name.namespace",
    "entity.name.module",
    "support.module"
   ],
   "settings": {
    "foreground": "#a6a4a2",
    "fontStyle": "italic"
   }
  },
  {
   "name": "function",
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call"
   ],
   "settings": {
    "foreground": "#f6f5f4"
   }
  },
  {
   "name": "variable",
   "scope": [
    "variable",
    "variable.parameter",
    "meta.definition.variable"
   ],
   "settings": {
    "foreground": "#f6f5f4"
   }
  },
  {
   "name": "invalid",
   "scope": [
    "invalid",
    "invalid.illegal"
   ],
   "settings": {
    "foreground": "#ff6467"
   }
  },
  {
   "name": "markup heading",
   "scope": [
    "markup.heading",
    "entity.name.section"
   ],
   "settings": {
    "foreground": "#f6f5f4",
    "fontStyle": "bold"
   }
  },
  {
   "name": "markup",
   "scope": [
    "markup.inserted"
   ],
   "settings": {
    "foreground": "#5fd18b"
   }
  },
  {
   "name": "markup deleted",
   "scope": [
    "markup.deleted"
   ],
   "settings": {
    "foreground": "#ff6467"
   }
  }
 ],
 "semanticTokenColors": {
  "comment": {
   "foreground": "#a6a4a2",
   "bold": false,
   "italic": true
  },
  "keyword": {
   "foreground": "#f6f5f4",
   "bold": true,
   "italic": false
  },
  "type": {
   "foreground": "#ceccca",
   "bold": false,
   "italic": true
  },
  "string": {
   "foreground": "#5fd18b",
   "bold": false,
   "italic": false
  },
  "number": {
   "foreground": "#d6d4d2",
   "bold": false,
   "italic": false
  },
  "operator": {
   "foreground": "#a6a4a2",
   "bold": false,
   "italic": false
  },
  "property": {
   "foreground": "#d6d4d2",
   "bold": false,
   "italic": false
  },
  "namespace": {
   "foreground": "#a6a4a2",
   "bold": false,
   "italic": true
  }
 }
}
