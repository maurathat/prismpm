 },
 "tokenColors": [
  {
   "name": "comment",
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#6a9955"
   }
  },
  {
   "name": "string",
   "scope": [
    "string",
    "string.quoted",
    "string.template",
    "meta.embedded.assembly"
   ],
   "settings": {
    "foreground": "#ce9178"
   }
  },
  {
   "name": "regular expression",
   "scope": [
    "string.regexp"
   ],
   "settings": {
    "foreground": "#d16969"
   }
  },
  {
   "name": "escape",
   "scope": [
    "constant.character.escape"
   ],
   "settings": {
    "foreground": "#d7ba7d"
   }
  },
  {
   "name": "number",
   "scope": [
    "constant.numeric",
    "keyword.other.unit"
   ],
   "settings": {
    "foreground": "#b5cea8"
   }
  },
  {
   "name": "keyword",
   "scope": [
    "keyword",
    "storage",
    "storage.type",
    "storage.modifier",
    "constant.language",
    "meta.preprocessor",
    "entity.name.tag",
    "variable.language"
   ],
   "settings": {
    "foreground": "#569cd6"
   }
  },
  {
   "name": "control keyword",
   "scope": [
    "keyword.control",
    "keyword.operator.new",
    "keyword.other.using",
    "keyword.other.operator"
   ],
   "settings": {
    "foreground": "#c586c0"
   }
  },
  {
   "name": "operator",
   "scope": [
    "keyword.operator",
    "punctuation",
    "meta.brace"
   ],
   "settings": {
    "foreground": "#d4d4d4"
   }
  },
  {
   "name": "type",
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "entity.name.namespace",
    "entity.name.scope-resolution",
    "support.type",
    "support.class",
    "entity.other.inherited-class"
   ],
   "settings": {
    "foreground": "#4ec9b0"
   }
  },
  {
   "name": "function",
   "scope": [
    "entity.name.function",
    "support.function",
    "support.constant.handlebars"
   ],
   "settings": {
    "foreground": "#dcdcaa"
   }
  },
  {
   "name": "variable",
   "scope": [
    "variable",
    "meta.definition.variable.name",
    "support.variable",
    "entity.name.variable",
    "entity.other.attribute-name",
    "support.type.property-name",
    "meta.object-literal.key"
   ],
   "settings": {
    "foreground": "#9cdcfe"
   }
  },
  {
   "name": "constant",
   "scope": [
    "variable.other.constant",
    "variable.other.enummember"
   ],
   "settings": {
    "foreground": "#4fc1ff"
   }
  },
  {
   "name": "invalid",
   "scope": [
    "invalid",
    "invalid.illegal"
   ],
   "settings": {
    "foreground": "#f44747"
   }
  },
  {
   "name": "markup heading",
   "scope": [
    "markup.heading",
    "entity.name.section"
   ],
   "settings": {
    "foreground": "#569cd6",
    "fontStyle": "bold"
   }
  },
  {
   "name": "markup bold",
   "scope": [
    "markup.bold"
   ],
   "settings": {
    "foreground": "#569cd6",
    "fontStyle": "bold"
   }
  },
  {
   "name": "markup italic",
   "scope": [
    "markup.italic"
   ],
   "settings": {
    "foreground": "#d4d4d4",
    "fontStyle": "italic"
   }
  },
  {
   "name": "markup inserted",
   "scope": [
    "markup.inserted"
   ],
   "settings": {
    "foreground": "#b5cea8"
   }
  },
  {
   "name": "markup deleted",
   "scope": [
    "markup.deleted"
   ],
   "settings": {
    "foreground": "#ce9178"
   }
  }
 ],
 "semanticTokenColors": {
  "keyword": "#569cd6",
  "type": "#4ec9b0",
  "string": "#ce9178",
  "number": "#b5cea8",
  "operator": "#d4d4d4",
  "property": "#9cdcfe",
  "namespace": "#4ec9b0",
  "comment": "#6a9955"
 }
}
